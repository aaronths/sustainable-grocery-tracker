PORT=4000
OFFSET_PRICE_PER_TONNE_CENTS=4000

# Required for real receipt parsing via Claude's vision API, and for
# classifying patient conditions into diet flags (see src/domain/health.ts).
# Without it, uploads/classification fall back to canned fixtures.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — sent as a header to the Finchnode sandbox if present; the demo
# API itself requires no auth. Without it, requests are still made normally.
FINCHNODE_SANDBOX_KEY=
